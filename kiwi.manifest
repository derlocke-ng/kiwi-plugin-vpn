# kiwi.manifest — app metadata for kiwi-updater
NAME=kiwi-plugin-vpn
DESCRIPTION=exit through a WireGuard/OpenVPN tunnel (gluetun) — a kiwi-proxy provider module
VERSION=0.2.0
AUTHOR=derlocke-ng
HOMEPAGE=https://github.com/derlocke-ng/kiwi-plugin-vpn
LICENSE=GPL-3.0-or-later

# A provider module for kiwi-proxy: installed into kiwi-proxy's modules directory,
# not a standalone app. No bin, no GUI — kiwi-proxy manages its lifecycle, for
# kiwi-fox, kiwi-pentesting and anything else that uses its exits.
COMPONENTS=module
CATEGORY=Security
TAGS=kiwi-proxy kiwi-fox provider vpn gluetun wireguard openvpn socks5 podman

SCOPES=user

ICON=data/kiwi-plugin.svg
ABOUT=README.md

# Checked with `command -v` before installing. The provider image is built or
# pulled by `kiwi-proxy setup` (or `kiwi-proxy module setup vpn`), not here.
DEPENDS=kiwi-proxy podman

INSTALLER=install.sh
